{
  "name": "mane-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "license:issue": "pnpm --filter @mane/license issue",
    "landing": "pnpm --filter web export:landing"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
