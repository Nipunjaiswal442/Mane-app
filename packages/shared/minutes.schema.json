{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "held_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "matched_user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name", "matched_user_id"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "agenda": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["start_s", "end_s"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["text", "evidence"],
        "additionalProperties": false
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": ["start_s", "end_s"],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": ["text", "owner", "due_date", "evidence"],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_meeting": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "held_at",
    "attendees",
    "summary",
    "agenda",
    "decisions",
    "action_items",
    "open_questions",
    "risks",
    "next_meeting",
    "confidence_notes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
