# Copy with make setup; it generates WORKER_TOKEN once when creating .env.
# Runtime stays local; package/model acquisition is a separate preparation step.
DATABASE_URL=postgres://mane:mane@127.0.0.1:5432/mane
DATABASE_TEST_URL=postgres://mane:mane@127.0.0.1:5432/mane_test
POSTGRES_PORT=5432
HOST=127.0.0.1
PORT=4000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api
WEB_ORIGIN=http://localhost:3000
CSRF_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
AUTH_PROVIDER=local
WORKER_TOKEN=GENERATE_WITH_MAKE_SETUP

STORAGE_BACKEND=local
DATA_DIR=./data
STT_BACKEND=mlx
STT_MODEL_PATH=./models/whisper-mlx
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_CONTEXT_TOKENS=16384
OLLAMA_URL=http://127.0.0.1:11434
DIARIZE=off
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
NEXT_TELEMETRY_DISABLED=1

# Optional local development license; missing license uses a 14-day evaluation.
# LICENSE_PUBLIC_KEY_PATH=./data/licenses/public.pem

# Customer-local OIDC only; first provision the org/admin in local mode.
# OIDC_ISSUER=http://localhost:8080
# OIDC_CLIENT_ID=mane
# OIDC_CLIENT_SECRET=provision-a-local-client-secret
# OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback

# Production containers set these explicitly, see infra/compose.prod.yml.
# INTERNAL_HOSTS=postgres,api,worker,vllm,minio,web
# APPLIANCE_HOSTS=postgres,api,worker,vllm,minio,web
